# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter .env.

# Base PostgreSQL. En production (Neon) : adresse « poolée » (hôte en -pooler), avec ?sslmode=require.
DATABASE_URL=postgres://localhost:5432/pertes_dev

# Nombre maximal de connexions par instance (production serverless : 3).
DB_POOL_MAX=10

# Date de mise en service des alertes « saisie incomplète » (AAAA-MM-JJ). Vide = aucune alerte.
ALERTES_DEBUT=
